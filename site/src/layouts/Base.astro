---
import '../../../src/renderer/src/styles/base.css'
import '../../../src/renderer/src/styles/items.css'
import '../../../src/renderer/src/styles/embed.css'
import '../../../src/renderer/src/styles/code.css'
import '../../../src/renderer/src/styles/help.css'
import '../../../src/renderer/src/styles/tooltip.css'
import '../styles/site.css'
import icon from '../../../resources/icon.png'
import { Check, ChevronDown, Globe, Monitor, Moon, Sun } from 'lucide-react'
import { LANG_NAMES, LANGS } from '../../../src/core/i18n'
import type { Lang } from '../../../src/core/i18n'
import { en } from '../../../src/core/i18n/en'
import { ja } from '../../../src/core/i18n/ja'
import { THEMES } from '../../../src/core/theme'
import { href, REPO_URL, SITE } from '../i18n'

interface Props {
  lang: Lang
  title?: string
  /** 言語を切り替えたときに開くパス（言語の部分を除く） */
  path: string
}

const { lang, title, path } = Astro.props
const m = SITE[lang]
// 言語・テーマの切り替えの文言はアプリと同じ
const ui = { ja, en }[lang].ui
const themeIcons = { system: Monitor, light: Sun, dark: Moon }
const pageTitle = title ? `${title} | WorkLauncher` : 'WorkLauncher'
---

<html lang={m.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={m.siteDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={m.siteDescription} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href={icon.src} />
    <link rel="alternate" hreflang="ja" href={new URL(href('ja', path), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', path), Astro.site)} />
    <!-- 選んだテーマを描く前に当てる（ちらつかないよう、読み込みを待たない） -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme')
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="s-header">
      <div class="s-header-inner">
        <a class="s-brand" href={href(lang)}>
          <img src={icon.src} alt="" width="28" height="28" />
          <span>WorkLauncher</span>
        </a>
        <nav class="s-nav">
          <a href={href(lang, 'docs/start/')}>{m.nav.docs}</a>
          <a href={href(lang, 'try/')}>{m.nav.try}</a>
          <a href={href(lang, 'releases/')}>{m.nav.releases}</a>
          <a href={`${href(lang)}#download`}>{m.nav.download}</a>
          <a href={REPO_URL} rel="noopener">{m.nav.github}</a>
        </nav>
        <div class="s-switches">
          <details class="s-menu">
            <summary aria-label={`${ui.langSwitch}: ${LANG_NAMES[lang]}`} title={ui.langSwitch}>
              <Globe size={16} aria-hidden="true" />
              <span>{LANG_NAMES[lang]}</span>
              <ChevronDown size={14} aria-hidden="true" />
            </summary>
            <div class="s-menu-list">
              {
                LANGS.map((l) => (
                  <a href={href(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
                    <Check size={14} aria-hidden="true" className="s-menu-check" />
                    {LANG_NAMES[l]}
                  </a>
                ))
              }
            </div>
          </details>
          <details class="s-menu s-theme">
            <summary aria-label={ui.theme} title={ui.theme}>
              {
                THEMES.map((v) => {
                  const ThemeIcon = themeIcons[v]
                  return <ThemeIcon size={16} aria-hidden="true" className={`s-theme-icon s-theme-${v}`} />
                })
              }
              <ChevronDown size={14} aria-hidden="true" />
            </summary>
            <div class="s-menu-list">
              {
                THEMES.map((v) => {
                  const ThemeIcon = themeIcons[v]
                  return (
                    <button type="button" data-theme-choice={v}>
                      <Check size={14} aria-hidden="true" className="s-menu-check" />
                      <ThemeIcon size={14} aria-hidden="true" />
                      {ui.themes[v]}
                    </button>
                  )
                })
              }
            </div>
          </details>
        </div>
      </div>
    </header>
    <slot />
    <footer class="s-footer">
      <div class="s-container">
        <span>© kazunori0909 · {m.footer}</span>
        <a href={REPO_URL} rel="noopener">GitHub</a>
      </div>
    </footer>
    <script>
      import { initMenus } from '../menus'
      initMenus()
    </script>
  </body>
</html>
