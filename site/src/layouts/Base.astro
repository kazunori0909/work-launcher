---
import '../../../src/renderer/src/assets/styles/base.css'
import '../../../src/renderer/src/assets/styles/items.css'
import '../../../src/renderer/src/assets/styles/embed.css'
import '../../../src/renderer/src/assets/styles/code.css'
import '../../../src/renderer/src/assets/styles/help.css'
import '../../../src/renderer/src/assets/styles/tooltip.css'
import '../styles/site.css'
import icon from '../../../resources/icon.png'
import type { Lang } from '../../../src/core/i18n'
import { href, REPO_URL, SITE } from '../i18n'

interface Props {
  lang: Lang
  title?: string
  /** 言語を切り替えたときに開くパス（言語の部分を除く） */
  path: string
}

const { lang, title, path } = Astro.props
const m = SITE[lang]
const other: Lang = lang === 'ja' ? 'en' : 'ja'
const pageTitle = title ? `${title} | WorkLauncher` : 'WorkLauncher'
---

<html lang={m.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={m.siteDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={m.siteDescription} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href={icon.src} />
    <link rel="alternate" hreflang="ja" href={new URL(href('ja', path), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', path), Astro.site)} />
  </head>
  <body>
    <header class="s-header">
      <div class="s-header-inner">
        <a class="s-brand" href={href(lang)}>
          <img src={icon.src} alt="" width="28" height="28" />
          <span>WorkLauncher</span>
        </a>
        <nav class="s-nav">
          <a href={href(lang, 'docs/start/')}>{m.nav.docs}</a>
          <a href={`${href(lang)}#download`}>{m.nav.download}</a>
          <a href={REPO_URL} rel="noopener">{m.nav.github}</a>
          <a class="s-lang" href={href(other, path)} hreflang={other} lang={other}>{m.langSwitch}</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="s-footer">
      <div class="s-container">
        <span>© kazunori0909 · {m.footer}</span>
        <a href={REPO_URL} rel="noopener">GitHub</a>
      </div>
    </footer>
  </body>
</html>
